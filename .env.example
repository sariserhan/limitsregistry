# Local Docker default. Use the Neon pooled connection string in Vercel.
DATABASE_URL=postgres://limits:limits@localhost:5433/limits_registry
NODE_ENV=development

# Better Auth — generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Vercel AI Gateway — required for Research Console AI extraction; unneeded on Vercel (uses OIDC).
AI_GATEWAY_API_KEY=

# Resend — transactional and digest emails. See vercel.com/marketplace/resend.
# Senders are hardcoded per purpose in src/lib/email/resend.ts (welcome@, support@) —
# both must be verified on the limitsregistry.com domain in Resend.
RESEND_API_KEY=

# Weekly digest cron (app/api/cron/weekly-digest) — generate with `openssl rand -base64 32`.
# Vercel sends this automatically as `Authorization: Bearer <value>` per vercel.json's schedule.
CRON_SECRET=

# Legacy bearer token for the pre-Better-Auth editorial API guard — superseded
# by src/auth/session.ts requireRole(), kept only until callers migrate off it.
EDITORIAL_ADMIN_TOKEN=replace-with-a-long-random-token
