# Local Docker default. Use the Neon pooled connection string in Vercel.
DATABASE_URL=postgres://limits:limits@localhost:5433/limits_registry
NODE_ENV=development

# Better Auth — generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Vercel AI Gateway — required for Research Console AI extraction; unneeded on Vercel (uses OIDC).
AI_GATEWAY_API_KEY=

# Resend — auth emails (verification, password reset). See vercel.com/marketplace/resend.
RESEND_API_KEY=
EMAIL_FROM="Limits Registry <auth@limitsregistry.com>"
